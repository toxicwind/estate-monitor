#!/usr/bin/env bash
# estate-monitor — primary operation: runs the process-watchdog / repo-radar /
# recursive-fallback watchers headlessly for a one-shot supervised loop.
# Usage: bin/run [watchdog|repo-radar|fallback]
set -euo pipefail
cd "$(dirname "$0")/.."
BUN="${BUN:-/home/toxic/.bun/bin/bun}"
case "${1:-watchdog}" in
  watchdog) exec "$BUN" run watchdog.ts ;;
  repo-radar) exec "$BUN" run repo-radar.ts ;;
  fallback) exec "$BUN" run recursive-fallback.ts ;;
  check) exec ./bin/check ;;
  *) echo "usage: bin/run [watchdog|repo-radar|fallback|check]"; exit 2 ;;
esac